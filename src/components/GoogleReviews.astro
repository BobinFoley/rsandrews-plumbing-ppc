---
interface Props {
  variant?: 'top' | 'bottom';
}

const { variant = 'top' } = Astro.props;

const topReviews = [
  {
    initial: 'R',
    name: 'Reginald Peterson',
    time: 'Edited 22 minutes ago',
    avatarBg: '#ea4335',
    text: 'The RS Andrews plumber was right on time and very professional. He diagnosed our leaking water heater immediately, explained everything clearly, and had the replacement installed the very same afternoon. Truly five-star service!',
  },
  {
    initial: 'A',
    name: 'Andy Marshall',
    time: 'Edited 30 minutes ago',
    avatarBg: '#34a853',
    text: 'Alberto was great, on time, quick and thorough with clearing our clogged main drain. Used the camera to show us the line was completely clear. Highly recommend RS Andrews plumbing!',
  },
  {
    initial: 'A',
    name: 'Ann Thompson',
    time: '48 minutes ago',
    avatarBg: '#fbbc05',
    text: 'Very knowledgeable licensed plumber and arrived quickly for an urgent bathroom pipe leak. Prompt diagnosis, no mess left behind, and excellent customer care.',
  },
  {
    initial: 'A',
    name: 'Amanda Brightman',
    time: '13 hours ago',
    avatarBg: '#4285f4',
    text: 'Fast emergency plumbing repair! Our kitchen pipe burst late in the evening and RS Andrews had a technician dispatched within minutes to shut it off and make the repair.',
  },
];

const bottomReviews = [
  {
    initial: 'C',
    name: 'Cyd Williams',
    time: 'an hour ago',
    avatarBg: '#4285f4',
    text: 'Received a pre-estimate from RS Andrews for installing a new gas line and tankless water heater. David Stitt was the technician. He was very pleasant, knowledgeable, and informative. We will definitely use RS Andrews for our plumbing projects.',
  },
  {
    initial: 'R',
    name: 'Raychang Tsao',
    time: '12 hours ago',
    avatarBg: '#34a853',
    text: 'Always dependable service and fair, upfront pricing. RS Andrews has taken care of our plumbing and home systems for years with great reliability.',
  },
  {
    initial: 'N',
    name: 'Nathan Mounts',
    time: '13 hours ago',
    avatarBg: '#ea4335',
    text: 'Excellent plumbing service! The technician showed up on time, replaced our faulty pressure valve, and had all the parts needed right on his truck.',
  },
  {
    initial: 'R',
    name: 'Ryan Vance',
    time: 'Edited 17 hours ago',
    avatarBg: '#4285f4',
    text: 'Paul was great. He hydro-jetted our sewer line and solved a recurring backup problem that two other plumbers could not fix. Very thankful for RS Andrews.',
  },
];

const reviews = variant === 'bottom' ? bottomReviews : topReviews;
---

<section class="google-reviews-section" aria-label="Google Customer Reviews">
  <div class="container reviews-container">
    <div class="reviews-header">
      <span class="gr-eyebrow">GOOGLE REVIEWS</span>
      <h2 class="gr-title">What Our Customers Say</h2>
      <div class="gr-rating-row">
        <div class="gr-stars">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <span class="gr-score">4.9</span>
        <span class="gr-count-badge">9,545 Google Reviews</span>
      </div>
      <a href="https://search.google.com/local/writereview?placeid=ChIJc12Z" target="_blank" rel="noopener noreferrer" class="btn-write-review">
        ★ Write a Google Review
      </a>
    </div>

    <div class="gr-cards-grid">
      {reviews.map(item => (
        <div class="gr-card">
          <div class="gr-card-head">
            <div class="gr-avatar" style={`background-color: ${item.avatarBg}`}>
              {item.initial}
            </div>
            <div class="gr-user-info">
              <strong class="gr-user-name">{item.name}</strong>
              <span class="gr-time">{item.time}</span>
            </div>
            <div class="gr-logo-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3h3.88c2.27-2.09 3.665-5.17 3.665-9.09z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.1C3.27 21.42 7.34 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.32A7.18 7.18 0 0 1 4.9 12c0-.81.14-1.59.38-2.32V6.58H1.25A11.96 11.96 0 0 0 0 12c0 1.92.45 3.74 1.25 5.42l4.03-3.1z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.27 2.58 1.25 6.58l4.03 3.1c.95-2.83 3.6-4.93 6.72-4.93z"/>
              </svg>
            </div>
          </div>
          <div class="gr-card-stars">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="gr-review-text">{item.text}</p>
        </div>
      ))}
    </div>

    <div class="gr-footer-action">
      <a href="https://www.google.com/search?q=RS+Andrews+Atlanta+reviews" target="_blank" rel="noopener noreferrer" class="btn-all-reviews">
        See All Reviews on Google ↗
      </a>
    </div>
  </div>
</section>

<style>
  .google-reviews-section {
    background: #fbf6c9;
    background: linear-gradient(180deg, #fff7c2 0%, #faefa9 100%);
    padding: 38px 0 46px;
    border-top: 1px solid #ebd879;
    border-bottom: 1px solid #ebd879;
  }
  .reviews-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .reviews-header {
    text-align: center;
    position: relative;
    margin-bottom: 26px;
  }
  .gr-eyebrow {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #0b7938;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }
  .gr-title {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    color: #112a3d;
    font-weight: 800;
    margin: 0 0 10px;
  }
  .gr-rating-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gr-stars {
    color: #f59e0b;
    font-size: 1.3rem;
    letter-spacing: 2px;
  }
  .gr-score {
    font-weight: 800;
    font-size: 1.15rem;
    color: #1a3548;
  }
  .gr-count-badge {
    background: #0066cc;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 4px;
  }
  .btn-write-review {
    display: inline-block;
    margin-top: 14px;
    background: #0d6efd;
    color: #fff;
    padding: 7px 16px;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 5px rgba(0,0,0,0.15);
  }
  .btn-write-review:hover {
    background: #0b5ed7;
  }
  .gr-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 24px;
  }
  .gr-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 18px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);
    border: 1px solid #ede8bf;
    display: flex;
    flex-direction: column;
  }
  .gr-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .gr-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gr-user-info {
    flex: 1;
    overflow: hidden;
  }
  .gr-user-name {
    display: block;
    font-size: 0.88rem;
    color: #1a3348;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gr-time {
    display: block;
    font-size: 0.75rem;
    color: #798a96;
  }
  .gr-logo-icon {
    flex-shrink: 0;
  }
  .gr-card-stars {
    color: #f59e0b;
    font-size: 1rem;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .gr-review-text {
    font-size: 0.86rem;
    line-height: 1.45;
    color: #3b4e5d;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gr-footer-action {
    text-align: center;
    margin-top: 28px;
  }
  .btn-all-reviews {
    display: inline-flex;
    align-items: center;
    background: #c62828;
    color: #fff;
    padding: 10px 24px;
    border-radius: 4px;
    font-size: 0.95rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 3px 8px rgba(198, 40, 40, 0.35);
    transition: background 0.2s;
  }
  .btn-all-reviews:hover {
    background: #a71d1d;
  }

  @media (max-width: 992px) {
    .gr-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .gr-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
