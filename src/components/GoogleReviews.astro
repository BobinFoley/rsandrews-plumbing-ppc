---
import { phone, phoneHref, reviewStats } from '../data/site';

interface Props {
  variant?: 'top' | 'bottom';
}

const { variant = 'top' } = Astro.props;

const topReviews = [
  {
    initial: 'R',
    name: 'Reginald Peterson',
    location: 'Atlanta, GA · Verified Google Review',
    avatarBg: '#ea4335',
    text: 'The RS Andrews plumber was right on time and very professional. He diagnosed our leaking water heater immediately, explained everything clearly, and had the replacement installed the very same afternoon. Truly five-star service!',
  },
  {
    initial: 'A',
    name: 'Andy Marshall',
    location: 'Marietta, GA · Verified Google Review',
    avatarBg: '#34a853',
    text: 'Alberto was great, on time, quick and thorough with clearing our clogged main drain. Used the camera to show us the line was completely clear. Highly recommend RS Andrews plumbing!',
  },
  {
    initial: 'A',
    name: 'Ann Thompson',
    location: 'Roswell, GA · Verified Google Review',
    avatarBg: '#e69500',
    text: 'Very knowledgeable licensed plumber and arrived quickly for an urgent bathroom pipe leak. Prompt diagnosis, no mess left behind, and excellent customer care.',
  },
  {
    initial: 'A',
    name: 'Amanda Brightman',
    location: 'Decatur, GA · Verified Google Review',
    avatarBg: '#4285f4',
    text: 'Fast emergency plumbing repair! Our kitchen pipe burst late in the evening and RS Andrews had a technician dispatched within minutes to shut it off and make the repair.',
  },
];

const bottomReviews = [
  {
    initial: 'C',
    name: 'Cyd Williams',
    location: 'Alpharetta, GA · Verified Google Review',
    avatarBg: '#4285f4',
    text: 'Received a clear upfront estimate from RS Andrews for installing a new gas line and tankless water heater. David was very pleasant, knowledgeable, and informative. We will definitely use RS Andrews for our plumbing projects.',
  },
  {
    initial: 'R',
    name: 'Raychang Tsao',
    location: 'Sandy Springs, GA · Verified Google Review',
    avatarBg: '#34a853',
    text: 'Always dependable service and fair, upfront pricing. RS Andrews has taken care of our plumbing and home water systems for years with great reliability.',
  },
  {
    initial: 'N',
    name: 'Nathan Mounts',
    location: 'Dunwoody, GA · Verified Google Review',
    avatarBg: '#ea4335',
    text: 'Excellent plumbing service! The technician showed up on time, replaced our faulty water pressure regulator, and had all the parts needed right on his truck.',
  },
  {
    initial: 'R',
    name: 'Ryan Vance',
    location: 'Smyrna, GA · Verified Google Review',
    avatarBg: '#4285f4',
    text: 'Paul was great. He hydro-jetted our sewer line and solved a recurring backup problem that two other plumbers could not fix. Very thankful for RS Andrews.',
  },
];

const reviews = variant === 'bottom' ? bottomReviews : topReviews;
---

<section class="google-reviews-section" aria-label="Google Customer Reviews">
  <div class="container reviews-container">
    <div class="reviews-header">
      <span class="gr-eyebrow">VERIFIED CUSTOMER REVIEWS</span>
      <h2 class="gr-title">What Metro Atlanta Homeowners Say</h2>
      <div class="gr-rating-row tabular-nums">
        <div class="gr-stars" aria-label="5 out of 5 stars">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <span class="gr-score">{reviewStats.rating}</span>
        <span class="gr-sep" aria-hidden="true">·</span>
        <span class="gr-count-text">{reviewStats.count} Google Reviews</span>
      </div>
    </div>

    <div class="gr-cards-grid">
      {reviews.map(item => (
        <article class="gr-card">
          <div class="gr-card-head">
            <div class="gr-avatar" style={`background-color: ${item.avatarBg}`} aria-hidden="true">
              {item.initial}
            </div>
            <div class="gr-user-info">
              <strong class="gr-user-name">{item.name}</strong>
              <span class="gr-time">{item.location}</span>
            </div>
            <div class="gr-logo-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3h3.88c2.27-2.09 3.665-5.17 3.665-9.09z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.1C3.27 21.42 7.34 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.32A7.18 7.18 0 0 1 4.9 12c0-.81.14-1.59.38-2.32V6.58H1.25A11.96 11.96 0 0 0 0 12c0 1.92.45 3.74 1.25 5.42l4.03-3.1z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.27 2.58 1.25 6.58l4.03 3.1c.95-2.83 3.6-4.93 6.72-4.93z"/>
              </svg>
            </div>
          </div>
          <div class="gr-card-stars" aria-label="5 stars">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="gr-review-text">{item.text}</p>
        </article>
      ))}
    </div>

    <div class="gr-footer-action">
      <a href={phoneHref} class="btn-phone-green gr-call-cta" data-call-location={`reviews_${variant}_cta`}>
        <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
        </svg>
        <span>Call {phone} for 5-Star Plumbing Service</span>
      </a>
    </div>
  </div>
</section>

<style>
  .google-reviews-section {
    background: linear-gradient(180deg, #fff8cc 0%, #faf0b1 100%);
    padding: 36px 0 42px;
    border-top: 1px solid #ebd879;
    border-bottom: 1px solid #ebd879;
  }
  .reviews-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .reviews-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .gr-eyebrow {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #0b6e34;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }
  .gr-title {
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    color: #112a3d;
    font-weight: 800;
    margin: 0 0 8px;
  }
  .gr-rating-row {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gr-stars {
    color: #d97706;
    font-size: 1.25rem;
    letter-spacing: 2px;
  }
  .gr-score {
    font-weight: 800;
    font-size: 1.12rem;
    color: #112a3d;
  }
  .gr-sep {
    color: #7c8e99;
    font-weight: 700;
  }
  .gr-count-text {
    font-size: 0.98rem;
    font-weight: 700;
    color: #0b559b;
  }
  .gr-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 22px;
  }
  .gr-card {
    background: #ffffff;
    border-radius: 8px;
    padding: 18px;
    box-shadow: 0 3px 12px rgba(16, 44, 67, 0.07);
    border: 1px solid #ede4b4;
    display: flex;
    flex-direction: column;
  }
  .gr-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .gr-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: #ffffff;
    font-weight: 800;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .gr-user-info {
    flex: 1;
    overflow: hidden;
  }
  .gr-user-name {
    display: block;
    font-size: 0.9rem;
    color: #133147;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gr-time {
    display: block;
    font-size: 0.74rem;
    color: #5e7484;
    font-weight: 600;
  }
  .gr-logo-icon {
    flex-shrink: 0;
  }
  .gr-card-stars {
    color: #d97706;
    font-size: 0.98rem;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .gr-review-text {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #324858;
    margin: 0;
  }
  .gr-footer-action {
    text-align: center;
    margin-top: 26px;
  }
  .gr-call-cta {
    font-size: 1.02rem;
    padding: 11px 24px;
  }

  @media (max-width: 992px) {
    .gr-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .gr-cards-grid {
      grid-template-columns: 1fr;
    }
    .gr-call-cta {
      width: 100%;
      max-width: 340px;
      font-size: 0.96rem;
    }
  }
</style>
