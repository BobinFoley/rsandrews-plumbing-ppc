---
import SiteLayout from '../layouts/SiteLayout.astro';
import { phone, phoneHref } from '../data/site';
import { getPlacementsForPage } from '../data/placements';

const homePlacements = getPlacementsForPage('/');
const homeHeroPlacement = homePlacements.find(p => p.zone === 'hero');
const homeHeroImage = homeHeroPlacement?.image || '/images/plumber-rsandrews.webp';
const homeHeroAlt = homeHeroPlacement?.imageAlt || 'RS Andrews 24/7 Emergency Plumbing Services in Metro Atlanta';
---

<SiteLayout
  title="Page Not Found"
  description="The page you are looking for does not exist. Call RS Andrews at 404-806-9284 for 24/7 plumbing, drain cleaning, and water heater services across Metro Atlanta."
  path="/404/"
  robots="noindex, follow"
>
  <!-- Top Hero Banner -->
  <section class="home-slider-hero" aria-label="RS Andrews Emergency Plumbing Hero">
    <img
      id="site-hero-img"
      src={homeHeroImage}
      alt={homeHeroAlt}
      width="1376"
      height="768"
      loading="eager"
    />
  </section>

  <section class="blue-title-ribbon">
    <div class="container hero-conversion-inner">
      <h1>Page Not Found (404)</h1>
      <div class="hero-cta-row">
        <a href={phoneHref} class="btn-phone-green hero-call-btn" data-call-location="404_hero_cta">
          <svg class="phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call {phone} Now</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding: 40px 0 60px; text-align: center;">
    <div class="container" style="max-width: 720px; margin: 0 auto;">
      <h2 style="font-size: 1.85rem; color: #143750; font-weight: 800; margin-bottom: 14px;">
        We Can't Find The Page You're Looking For
      </h2>
      <p style="font-size: 1.06rem; line-height: 1.6; color: #385060; margin-bottom: 28px;">
        The link may have moved or been updated. If you are experiencing a plumbing emergency, burst pipe, backed-up drain, or leaking water heater, our licensed Master Plumbers are on call 24 hours a day, 7 days a week.
      </p>

      <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-bottom: 36px;">
        <a href={phoneHref} class="btn-phone-green" data-call-location="404_body_cta">
          <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call {phone}</span>
        </a>
        <a href="/" class="btn-check-reviews" style="font-size: 1rem; padding: 11px 20px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10.5L12 3l9 7.5" />
            <path d="M5 9.5V20h14V9.5" />
          </svg>
          <span>Return to Homepage</span>
        </a>
        <a href="/sitemap/" style="display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px; background: #005fa8; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 800;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
            <line x1="9" y1="3" x2="9" y2="18" />
            <line x1="15" y1="6" x2="15" y2="21" />
          </svg>
          <span>Browse Service Areas</span>
        </a>
      </div>

      <div class="big-red-callout" style="margin-top: 30px;">
        <h3>24/7 Emergency Plumbing &amp; Drain Cleaning in Metro Atlanta</h3>
        <a class="big-red-phone" href={phoneHref} data-call-location="404_bottom_callout">{phone}</a>
      </div>
    </div>
  </section>
</SiteLayout>
