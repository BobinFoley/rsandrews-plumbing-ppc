---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
import { phone, phoneHref, services } from '../../data/site';
import { getPlacementsForPage } from '../../data/placements';

const blogPlacements = getPlacementsForPage('/blog/');
const blogHeroPlacement = blogPlacements.find(p => p.zone === 'hero');
const blogHeroImage = blogHeroPlacement?.image || '/images/plumber-rsandrews.webp';
const blogHeroAlt = blogHeroPlacement?.imageAlt || 'RS Andrews Plumbing Advice & Metro Atlanta Homeowner Guides';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const categories = Array.from(new Set(posts.map(p => p.data.category)));

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

const blogIndexKeywords = "Atlanta plumbing blog, plumbing advice, water heater repair tips, drain cleaning guide, emergency plumbing advice Georgia, RS Andrews";
const blogIndexExtraSchema = [
  {
    '@type': 'BreadcrumbList',
    '@id': 'https://rsandrews.247hvac.repair/blog/#breadcrumb',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://rsandrews.247hvac.repair/'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Plumbing Blog',
        item: 'https://rsandrews.247hvac.repair/blog/'
      }
    ]
  }
];
---

<SiteLayout
  title="Plumbing Tips, Water Heater Guides & Drain Advice Blog"
  description="Expert plumbing, water heater, and drain cleaning advice from RS Andrews. Learn how to prevent leaks, clear clogs, and choose the right water heater in Metro Atlanta."
  path="/blog/"
  keywords={blogIndexKeywords}
  extraSchema={blogIndexExtraSchema}
>
  <!-- Top Hero Banner -->
  <section class="home-slider-hero" aria-label="RS Andrews Emergency Plumbing Hero">
    <img
      id="site-hero-img"
      src={blogHeroImage}
      alt={blogHeroAlt}
      width="1376"
      height="768"
      loading="eager"
      referrerpolicy="no-referrer"
    />
  </section>

  <!-- Royal Blue Title Ribbon -->
  <div class="blue-title-ribbon">
    <div class="container">
      <h1>Plumbing Advice & Homeowner Guides</h1>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="blog-header-bar">
        <div class="section-heading" style="margin-bottom: 0;">
          <span class="eyebrow">Latest Articles</span>
          <h2>Homeowner Plumbing Guides</h2>
        </div>
        <div class="category-tags">
          <span class="category-pill active">All Topics ({posts.length})</span>
          {categories.map(cat => (
            <span class="category-pill">{cat}</span>
          ))}
        </div>
      </div>

      <div class="blog-grid">
        {posts.map(post => (
          <article class="blog-card">
            {post.data.image && (
              <a href={`/blog/${post.id}/`} class="blog-card-media" aria-label={post.data.title}>
                <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
                <span class="blog-category-badge">{post.data.category}</span>
              </a>
            )}
            <div class="blog-card-content">
              <div class="blog-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span class="meta-dot">·</span>
                <span>{post.data.author}</span>
              </div>
              <h3>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <div class="blog-card-footer">
                <a class="read-link" href={`/blog/${post.id}/`}>Read Article →</a>
                {post.data.tags.length > 0 && (
                  <span class="blog-tag-badge">#{post.data.tags[0]}</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Professional Support</span>
        <h2>Have a Question About Your Home Plumbing?</h2>
        <p class="lead">From preventative drain cleanings to 24/7 emergency pipe repair, RS Andrews Master Plumbers are always a quick call away.</p>
      </div>
      <div class="service-cards">
        {services.map(item => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.detail} throughout Metro Atlanta.</p>
            <a href={item.href}>Learn more →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div id="reviews">
    <GoogleReviews variant="bottom" />
  </div>

  <div class="container" style="margin: 35px auto 10px;">
    <div class="big-red-callout">
      <h3>Call For A Free Estimate on Water Heater Replacement & Repiping</h3>
      <a class="big-red-phone" href={phoneHref}>{phone}</a>
    </div>
  </div>
</SiteLayout>

<style>
  .blog-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e2ecf1;
  }
  .category-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .category-pill {
    display: inline-block;
    padding: 6px 14px;
    background: #eef4f8;
    color: #1a4a6e;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 20px;
  }
  .category-pill.active {
    background: #174a70;
    color: #fff;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
  }
  .blog-card {
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(14, 48, 64, 0.08);
    display: flex;
    flex-direction: column;
    border: 1px solid #e4ecf0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(14, 48, 64, 0.14);
  }
  .blog-card-media {
    position: relative;
    display: block;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #102c43;
  }
  .blog-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blog-card:hover .blog-card-media img {
    transform: scale(1.04);
  }
  .blog-category-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #d75b24;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 3px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .blog-card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-meta {
    font-size: 0.85rem;
    color: #637c8e;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .meta-dot {
    color: #b0c2cc;
  }
  .blog-card h3 {
    font-size: 1.25rem;
    line-height: 1.35;
    margin: 0 0 12px;
  }
  .blog-card h3 a {
    color: #143750;
    text-decoration: none;
  }
  .blog-card h3 a:hover {
    color: #d75b24;
  }
  .blog-card p {
    color: #4b6272;
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 20px;
    flex: 1;
  }
  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid #edf2f5;
  }
  .read-link {
    font-weight: 800;
    font-size: 0.92rem;
    color: #d75b24;
    text-decoration: none;
  }
  .read-link:hover {
    text-decoration: underline;
  }
  .blog-tag-badge {
    font-size: 0.8rem;
    color: #7b93a2;
    background: #f1f6f8;
    padding: 3px 8px;
    border-radius: 3px;
  }
  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
