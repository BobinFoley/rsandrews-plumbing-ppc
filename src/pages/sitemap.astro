---
import SiteLayout from '../layouts/SiteLayout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { getCollection } from 'astro:content';
import { phone, phoneHref, reviewStats, siteUrl } from '../data/site';
import { getPlacementsForPage } from '../data/placements';

const homePlacements = getPlacementsForPage('/');
const homeHeroPlacement = homePlacements.find(p => p.zone === 'hero');
const homeHeroImage = homeHeroPlacement?.image || '/images/plumber-rsandrews.webp';
const homeHeroAlt = homeHeroPlacement?.imageAlt || 'RS Andrews 24/7 Emergency Plumbing Services Across Metro Atlanta';

const allLocations = await getCollection('locations');
const services = (await getCollection('services')).sort((a,b) => a.data.title.localeCompare(b.data.title));
const blogPosts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const locationMap = new Map(allLocations.map(item => [item.data.city?.toLowerCase(), item.id]));

const col1Cities = ['Acworth', 'Alpharetta', 'Atlanta', 'Austell', 'Brookhaven', 'Buckhead', 'Buford', 'Chamblee', 'Clarkston', 'Cumming', 'Dacula'];
const col2Cities = ['Decatur', 'Doraville', 'Druid Hills', 'Duluth', 'Dunwoody', 'East Cobb', 'Flowery Branch', 'Grayson', 'Holly Springs', 'Johns Creek'];
const col3Cities = ['Kennesaw', 'Lawrenceville', 'Lilburn', 'Mableton', 'Marietta', 'Milton', 'Norcross', 'North Decatur', 'North Druid Hills', 'Peachtree Corners', 'Powder Springs'];
const col4Cities = ['Roswell', 'Sandy Springs', 'Smyrna', 'Snellville', 'Stone Mountain', 'Sugar Hill', 'Suwanee', 'Tucker', 'Vinings', 'Woodstock'];

function getCityHref(cityName: string) {
  const slug = locationMap.get(cityName.toLowerCase());
  return slug ? `/${slug}/` : '/sitemap/';
}

const sitemapKeywords = "RS Andrews service areas, Metro Atlanta plumbing service locations, plumber cities GA, emergency plumber service areas";
const sitemapGeo = {
  region: 'US-GA',
  placename: 'Atlanta, Georgia',
  position: '33.7490;-84.3880',
  icbm: '33.7490, -84.3880'
};
const sitemapExtraSchema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${siteUrl}/sitemap/#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Service Areas',
        item: `${siteUrl}/sitemap/`
      }
    ]
  }
];
---

<SiteLayout
  title="Sitemap and Service Areas"
  description="Browse all RS Andrews plumbing, drain cleaning, water heater, and emergency service pages and Metro Atlanta city directory. Call 404-806-9284 for 24/7 service."
  path="/sitemap/"
  keywords={sitemapKeywords}
  geo={sitemapGeo}
  extraSchema={sitemapExtraSchema}
>
  <!-- Clean Top Hero Banner -->
  <section class="home-slider-hero" aria-label="RS Andrews Emergency Plumbing Hero">
    <img
      id="site-hero-img"
      src={homeHeroImage}
      alt={homeHeroAlt}
      width="1376"
      height="768"
      loading="eager"
    />
  </section>

  <!-- Above-the-Fold Royal Blue Conversion Ribbon -->
  <section class="blue-title-ribbon" aria-label="Service Areas and Sitemap Header">
    <div class="container hero-conversion-inner">
      <h1>Metro Atlanta Plumbing Services &amp; Service Areas</h1>
      <p class="hero-trust-strip tabular-nums">
        <span class="trust-star">★ {reviewStats.rating}</span>
        <span>{reviewStats.count} Google Reviews</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>15 Residential Plumbing Services</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>42 Metro Atlanta Communities</span>
      </p>
      <div class="hero-cta-row">
        <a href={phoneHref} class="btn-phone-green hero-call-btn" data-call-location="sitemap_hero_cta">
          <svg class="phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call {phone} Now</span>
        </a>
        <span class="hero-cta-note">24/7 Local Dispatch · GA Master Plumber #MP210186</span>
      </div>
    </div>
  </section>

  <!-- Google Reviews -->
  <div id="reviews">
    <GoogleReviews variant="top" />
  </div>

  <!-- Services Section -->
  <section class="section" style="padding: 36px 0 10px;">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-size: clamp(1.4rem, 2.8vw, 1.95rem); color: #123954; font-weight: 800;">
          Residential Plumbing, Drain &amp; Emergency Services
        </h2>
      </div>

      <div class="service-cards-custom">
        <a href="/" class="service-card-item">
          <h3>Home</h3>
          <p>Main homepage, 5-star customer reviews, water heater brands &amp; 24/7 emergency dispatch.</p>
        </a>
        {services.map(page => (
          <a href={`/${page.id}/`} class="service-card-item">
            <h3>{page.data.title}</h3>
            <p>{page.data.description}</p>
          </a>
        ))}
        <a href="/blog/" class="service-card-item">
          <h3>Plumbing Advice &amp; Blog</h3>
          <p>Guides, troubleshooting tips, drain cleaning advice, and water heater buyer guides.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Deep Blue Metro Atlanta Service Area Box -->
  <section class="blue-service-box-section">
    <div class="container">
      <div class="blue-service-box">
        <h2>RS Andrews Plumbing, Drain Cleaning, and Water Heater Service Area</h2>

        <div class="blue-service-cities-grid">
          <div class="city-col">
            {col1Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col2Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col3Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col4Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
        </div>

        <div class="blue-service-bottom-bar">
          Plumbing Repair, Drain Cleaning, Water Heater Replacement, and Sewer Line Solutions. Call {phone} for Same-Day Dispatch.
        </div>
      </div>
    </div>
  </section>

  <!-- Plumbing Advice & Guides -->
  <section class="section" style="padding-top: 10px;">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-size: clamp(1.35rem, 2.6vw, 1.85rem); color: #123954; font-weight: 800;">
          Plumbing Guides &amp; Articles
        </h2>
      </div>
      <div class="service-cards-custom" style="grid-template-columns: repeat(2, 1fr);">
        {blogPosts.map(post => (
          <a href={`/blog/${post.id}/`} class="service-card-item">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Big Red Estimate Callout -->
  <div class="container">
    <div class="big-red-callout" style="margin-bottom: 45px;">
      <h3>Call For A Free Estimate on Water Heater Replacement &amp; Repiping</h3>
      <a class="big-red-phone" href={phoneHref} data-call-location="sitemap_bottom_callout">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
        </svg>
        <span>{phone}</span>
      </a>
    </div>
  </div>
</SiteLayout>

<style>
  .service-cards-custom {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .service-card-item {
    background: #ffffff;
    border: 1px solid #d4e3ed;
    border-top: 4px solid #005fa8;
    border-radius: 6px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-top-color 0.2s ease;
  }
  .service-card-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    border-top-color: #d32f2f;
  }
  .service-card-item h3 {
    margin: 0 0 8px;
    font-size: 1.12rem;
    font-weight: 800;
    color: #0b559b;
  }
  .service-card-item p {
    margin: 0;
    font-size: 0.88rem;
    color: #435b6c;
    line-height: 1.48;
  }
  @media (max-width: 900px) {
    .service-cards-custom {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .service-cards-custom {
      grid-template-columns: 1fr;
    }
  }
</style>
