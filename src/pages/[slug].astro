---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import FAQ from '../components/FAQ.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { phone, phoneHref, reviewStats, siteUrl, stationedServiceGroups } from '../data/site';
import { getPlacementsForPage } from '../data/placements';
import { getCityGeoData } from '../data/city-geo';

export async function getStaticPaths() {
  const entries = [...await getCollection('locations'), ...await getCollection('services')];
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isLocation = entry.data.type === 'location';
const currentPath = `/${entry.id}/`;
const placements = getPlacementsForPage(currentPath);

const homePlacements = getPlacementsForPage('/');
const homeHeroPlacement = homePlacements.find(p => p.zone === 'hero');
const heroPlacement = placements.find(p => p.zone === 'hero');
const topPlacement = placements.find(p => p.zone === 'top-content' || (!heroPlacement && p.zone === 'hero'));

// Use the hero image from the home page on all pages
const heroImage = homeHeroPlacement?.image || '/images/plumber-rsandrews.webp';
const heroImageAlt = homeHeroPlacement?.imageAlt || `${entry.data.title} - RS Andrews Emergency Plumbing Metro Atlanta`;

const displayImage = topPlacement?.image || (entry.data.pageImage || '/images/plumber-soldering-a-small-copper-joint.webp');
const displayImageAlt = topPlacement?.imageAlt || (entry.data.pageImageAlt || 'RS Andrews Master Plumber soldering copper pipe joint in Metro Atlanta');
const displayCaption = topPlacement?.caption || 'Licensed Master Plumbers servicing Metro Atlanta since 1968';

const allLocations = await getCollection('locations');
const locationMap = new Map(allLocations.map(item => [item.data.city?.toLowerCase(), item.id]));

const col1Cities = ['Acworth', 'Alpharetta', 'Atlanta', 'Austell', 'Brookhaven', 'Buckhead', 'Buford', 'Chamblee', 'Clarkston', 'Cumming', 'Dacula'];
const col2Cities = ['Decatur', 'Doraville', 'Druid Hills', 'Duluth', 'Dunwoody', 'East Cobb', 'Flowery Branch', 'Grayson', 'Holly Springs', 'Johns Creek'];
const col3Cities = ['Kennesaw', 'Lawrenceville', 'Lilburn', 'Mableton', 'Marietta', 'Milton', 'Norcross', 'North Decatur', 'North Druid Hills', 'Peachtree Corners', 'Powder Springs'];
const col4Cities = ['Roswell', 'Sandy Springs', 'Smyrna', 'Snellville', 'Stone Mountain', 'Sugar Hill', 'Suwanee', 'Tucker', 'Vinings', 'Woodstock'];

function getCityHref(cityName: string) {
  const slug = locationMap.get(cityName.toLowerCase());
  return slug ? `/${slug}/` : '/sitemap/';
}

const cityName = entry.data.city || (isLocation ? entry.id.replace(/-(?:air-conditioning-repair|plumber|plumbing-repair|plumbing)$/, '') : undefined);
const geoLookup = getCityGeoData(cityName || entry.id);
const displayCity = geoLookup?.city || entry.data.city || cityName;

const geoLatitude = entry.data.latitude || geoLookup?.latitude;
const geoLongitude = entry.data.longitude || geoLookup?.longitude;
const geoPlacename = geoLookup?.placename || (displayCity ? `${displayCity}, Georgia` : undefined);
const geoRegion = geoLookup?.region || (displayCity ? 'US-GA' : undefined);
const geoPosition = (geoLatitude && geoLongitude) ? `${geoLatitude};${geoLongitude}` : undefined;
const geoIcbm = (geoLatitude && geoLongitude) ? `${geoLatitude}, ${geoLongitude}` : undefined;

const serviceKeywords = !isLocation ? `${entry.data.title}, Atlanta plumbing service, emergency plumber Atlanta, water heater repair Atlanta GA, RS Andrews Plumbing` : undefined;
const seoKeywords = entry.data.keywords || (geoLookup?.serviceKeywords ? geoLookup.serviceKeywords.join(', ') : (displayCity ? `${displayCity} plumber, emergency plumber ${displayCity} GA, drain cleaning ${displayCity}, water heater repair ${displayCity} GA, RS Andrews ${displayCity}` : serviceKeywords));

const introHeading = isLocation
  ? `Trusted ${displayCity} Plumbers — Fast 24/7 Local Dispatch`
  : `${entry.data.title} Across Metro Atlanta`;

const extraSchema: any[] = [];
const canonicalUrl = `${siteUrl}${currentPath}`;

if (isLocation && (displayCity || geoLookup)) {
  const schemaCity = displayCity || entry.data.title;
  extraSchema.push({
    '@type': 'Service',
    '@id': `${canonicalUrl}#service`,
    name: `Plumbing & Drain Services in ${schemaCity}, GA`,
    serviceType: 'Emergency Plumbing, Water Heater, Drain Cleaning & Diagnostics',
    description: entry.data.description,
    image: `${siteUrl}/images/plumber-rsandrews.webp`,
    provider: {
      '@type': 'Plumber',
      '@id': `${siteUrl}/#business`,
      name: 'RS Andrews Plumbing',
      telephone: phone,
      url: siteUrl,
      image: `${siteUrl}/images/plumber-rsandrews.webp`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3617 Clearview Parkway',
        addressLocality: 'Atlanta',
        addressRegion: 'GA',
        postalCode: '30340',
        addressCountry: 'US'
      }
    },
    areaServed: {
      '@type': 'City',
      name: schemaCity,
      ...(geoLookup?.postalCodes ? { postalCode: geoLookup.postalCodes } : {}),
      containedInPlace: {
        '@type': 'State',
        name: 'Georgia'
      },
      ...(geoLatitude && geoLongitude ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: geoLatitude,
          longitude: geoLongitude
        }
      } : {})
    },
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: {
        '@type': 'ContactPoint',
        telephone: phone,
        contactType: 'emergency'
      }
    }
  });

  extraSchema.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Service Areas',
        item: `${siteUrl}/sitemap/`
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: entry.data.title,
        item: canonicalUrl
      }
    ]
  });
} else if (!isLocation) {
  extraSchema.push({
    '@type': 'Service',
    '@id': `${canonicalUrl}#service`,
    name: entry.data.title,
    serviceType: 'Plumbing and Drain Services',
    description: entry.data.description,
    image: `${siteUrl}/images/plumber-rsandrews.webp`,
    provider: {
      '@type': 'Plumber',
      '@id': `${siteUrl}/#business`,
      name: 'RS Andrews Plumbing',
      telephone: phone,
      url: siteUrl,
      image: `${siteUrl}/images/plumber-rsandrews.webp`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3617 Clearview Parkway',
        addressLocality: 'Atlanta',
        addressRegion: 'GA',
        postalCode: '30340',
        addressCountry: 'US'
      }
    },
    areaServed: {
      '@type': 'Place',
      name: 'Metro Atlanta'
    }
  });

  extraSchema.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/`
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: entry.data.title,
        item: canonicalUrl
      }
    ]
  });
}
---

<SiteLayout
  title={entry.data.title}
  description={entry.data.description}
  path={currentPath}
  image={displayImage}
  imageAlt={displayImageAlt}
  keywords={seoKeywords}
  geo={geoRegion ? { region: geoRegion, placename: geoPlacename, position: geoPosition, icbm: geoIcbm } : undefined}
  extraSchema={extraSchema}
>
  <!-- 1. Clean Top Hero Banner (No Overlay Text) -->
  <section class="home-slider-hero" aria-label={`${entry.data.title} Hero Banner`}>
    <img
      id="site-hero-img"
      src={heroImage}
      alt={heroImageAlt}
      width="1376"
      height="768"
      loading="eager"
    />
  </section>

  <!-- 2. Above-the-Fold Royal Blue Conversion Ribbon (Directly Under Hero Photo) -->
  <section class="blue-title-ribbon" aria-label="Primary Plumbing Call to Action">
    <div class="container hero-conversion-inner">
      <h1>{entry.data.title}</h1>
      <p class="hero-trust-strip tabular-nums">
        <span class="trust-star">★ {reviewStats.rating}</span>
        <span>{reviewStats.count} Google Reviews</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>GA Master Plumber #MP210186</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>Upfront Flat-Rate Pricing</span>
      </p>
      <div class="hero-cta-row">
        <a href={phoneHref} class="btn-phone-green hero-call-btn" data-call-location="hero_cta">
          <svg class="phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call {phone} Now</span>
        </a>
        <span class="hero-cta-note">
          {isLocation ? `Plumbers Stationed Near ${displayCity} 24/7` : 'Live Local Dispatch 24/7 · Same-Day Service Available'}
        </span>
      </div>
    </div>
  </section>

  <!-- 3. Verified Google Reviews Section -->
  <div id="reviews">
    <GoogleReviews variant="top" />
  </div>

  <!-- 4. Balanced Intro Overview & Framed Photo (Zero Vertical Whitespace Gap) -->
  <section class="section">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-copy">
          <h2>{introHeading}</h2>
          <p>
            <strong>RS Andrews Plumbing</strong> has earned Metro Atlanta's trust since 1968. As licensed Georgia Master Plumbers (#MP210186), we protect homes from burst pipes, drain backups, hidden water leaks, and water heater failures with upfront flat-rate pricing and a 100% satisfaction guarantee.
          </p>
          <p>
            {entry.data.description} Call our dispatch line at {phone} anytime—day, night, or weekend—for fast local plumbing service{isLocation ? ` in ${displayCity}` : ' across Metro Atlanta'}.
          </p>
          <div style="margin-top: 20px;">
            <a href={phoneHref} class="btn-phone-green" data-call-location="intro_cta">
              <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Call {phone} Now</span>
            </a>
          </div>
        </div>

        <div class="framed-photo-box">
          <figure>
            <img
              src={displayImage}
              alt={displayImageAlt}
              width="480"
              height="360"
              loading="lazy"
            />
            <figcaption>{displayCaption}</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Detailed Service / City Content + Sticky Call Sidebar Card -->
  <section class="service-detail-section">
    <div class="container service-detail-layout">
      <div class="service-detail-body">
        <Content />
      </div>

      <aside class="service-call-card" aria-label="Direct Plumbing Dispatch Card">
        <h3>Need a Plumber {isLocation ? `in ${displayCity}` : 'Today'}?</h3>
        <p>Speak directly with our local Atlanta plumbing dispatch team for same-day service or 24/7 emergency repairs.</p>
        <a href={phoneHref} class="btn-phone-green" data-call-location="sticky_sidebar_cta">
          <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>{phone}</span>
        </a>

        <ul class="service-trust-list">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            <span>GA Master Plumber #MP210186</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            <span>Upfront Flat-Rate Written Pricing</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            <span>24/7 Emergency &amp; Weekend Dispatch</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
            <span>Stocked Trucks · 100% Guarantee</span>
          </li>
        </ul>

        <div class="sidebar-quick-links">
          <h4>Popular Plumbing Services</h4>
          <a href="/24-7-emergency-plumbing/">24/7 Emergency Plumber</a>
          <a href="/water-heater-repair/">Water Heater Repair &amp; Install</a>
          <a href="/tankless-water-heaters/">Tankless Water Heaters</a>
          <a href="/drain-cleaning/">Drain Cleaning &amp; Hydro Jetting</a>
          <a href="/leak-detection-slab-leak-repair/">Leak Detection &amp; Slab Leaks</a>
          <a href="/sewer-line-repair/">Sewer Line Repair &amp; Camera</a>
          <a href="/whole-home-repiping/">Whole-Home Repiping</a>
          <a href="/plumbing-services/">View All 15 Plumbing Services →</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- 6. Boxed FAQ Accordion Section -->
  <div id="faq">
    <FAQ />
  </div>

  <!-- 7. Wide Brands & Fixtures Banner -->
  <section class="truck-banner-section" aria-label="Residential Plumbing Brands, Fixtures and Appliances">
    <div class="container">
      <img
        src="/images/residential-plumbing-brands-fixtures-appliances.webp"
        alt="RS Andrews Plumbing Brands, Fixtures and Appliances Servicing Metro Atlanta 365 Days a Year"
        width="1280"
        height="714"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 8. Second Two-Column Content & Photo -->
  <section class="section" style="padding: 20px 0 40px;">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-copy">
          <h2>Licensed Plumbers &amp; Stocked Service Vans Ready Across Metro Atlanta</h2>
          <p>
            Allow us to be your trusted partner in keeping your family's water supply and drainage systems safe and dependable. We are a locally operated plumbing and drain cleaning company holding Georgia Master Plumber License #MP210186. <strong>R.S. Andrews Plumbing</strong> services the entire Metro Atlanta region.
          </p>
          <p>
            Our team delivers quality workmanship using commercial-grade parts and employs background-checked, drug-tested plumbing technicians. If you need water heater replacement, drain unclogging, leak detection, or pipe repairs, call us today at {phone}.
          </p>
        </div>
        <div class="framed-photo-box">
          <figure>
            <img
              src="/images/tankless-water-heater5fg.webp"
              alt="RS Andrews High-Efficiency Tankless Water Heater Installation & Repair Metro Atlanta"
              width="480"
              height="480"
              loading="lazy"
            />
            <figcaption>Metro Atlanta Tankless Water Heater Installation &amp; Repair</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Second Google Reviews Section -->
  <GoogleReviews variant="bottom" />

  <!-- 10. Stationed Techs 24/7 Clickable Plumbing Services Section -->
  <section class="stationed-techs-section">
    <div class="container">
      <h2>Call R.S. Andrews Day or Night. Weekends Too. We've Got Plumbers Stationed Throughout Metro Atlanta 24/7 for Fast Local Service.</h2>

      <div class="stationed-cards-grid">
        {stationedServiceGroups.map(group => (
          <div class="stationed-card">
            <ul>
              {group.map(service => (
                <li><a href={service.href}>{service.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. Deep Blue Metro Atlanta Service Area Box -->
  <section class="blue-service-box-section">
    <div class="container">
      <div class="blue-service-box">
        <h2>RS Andrews Plumbing, Drain Cleaning, and Water Heater Service Area</h2>

        <div class="blue-service-cities-grid">
          <div class="city-col">
            {col1Cities.map(city => (
              <a href={getCityHref(city)} style={city.toLowerCase() === entry.data.city?.toLowerCase() ? "color: #ffe87a; font-weight: 800; text-decoration: underline;" : undefined}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col2Cities.map(city => (
              <a href={getCityHref(city)} style={city.toLowerCase() === entry.data.city?.toLowerCase() ? "color: #ffe87a; font-weight: 800; text-decoration: underline;" : undefined}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col3Cities.map(city => (
              <a href={getCityHref(city)} style={city.toLowerCase() === entry.data.city?.toLowerCase() ? "color: #ffe87a; font-weight: 800; text-decoration: underline;" : undefined}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col4Cities.map(city => (
              <a href={getCityHref(city)} style={city.toLowerCase() === entry.data.city?.toLowerCase() ? "color: #ffe87a; font-weight: 800; text-decoration: underline;" : undefined}>{city}</a>
            ))}
          </div>
        </div>

        <div class="blue-service-bottom-bar">
          Plumbing Repair, Drain Cleaning, Water Heater Replacement, and Sewer Line Solutions. Call {phone} for Same-Day Dispatch &amp; Financing Options.
        </div>
      </div>
    </div>
  </section>

  <!-- 12. Brands Serviced & Financing Section -->
  <section class="brands-financing-section">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-bottom: 30px;">
        <h2 style="font-size: clamp(1.35rem, 2.5vw, 1.85rem); color: #123954; font-weight: 800;">
          Plumbing &amp; Water Heater Brands Serviced: Bradford White, Rheem, A.O. Smith, Rinnai, Navien, Kohler, Moen, Delta, American Standard, and More.
        </h2>
      </div>

      <div class="brands-grid-layout">
        <div class="brands-media-box">
          <figure>
            <img
              src="/images/2558-rheem-water-heater-installation.webp"
              alt="RS Andrews Professional Rheem Water Heater Installation & Replacement Metro Atlanta"
              width="720"
              height="1280"
              loading="lazy"
              style="max-height: 520px; object-fit: cover;"
            />
            <figcaption>Professional Rheem Water Heater Installation &amp; Service</figcaption>
          </figure>
        </div>

        <div class="brands-copy-box">
          <h3>Water Heater Installation, Replacement and Financing for Metro Atlanta</h3>
          <p>
            If you need to replace your water heater or repair underground pipes at your home in <strong>{isLocation ? displayCity : 'Metro Atlanta'}</strong>, call the licensed Master Plumbers at <strong>R.S. Andrews Plumbing</strong> for an honest diagnosis and free second opinion.
          </p>
          <p>
            If replacement is your best option, <strong>R.S. Andrews</strong> will provide a transparent, written flat-rate quote detailed in every way, backed by flexible financing options. Call {phone} now.
          </p>

          <h4>Call For Special Seasonal Pricing on Tankless Systems</h4>
          <p>
            Upgrade to a modern <a href="/tankless-water-heaters/">tankless water heater</a> for continuous hot water on demand and lower monthly utility bills.
          </p>

          <h4>Flexible Financing Available At Competitive Rates</h4>
          <p>
            Our plumbing team is licensed, bonded, and insured. When unexpected plumbing emergencies arise, we offer <a href="/plumbing-financing/">financing plans</a> with affordable monthly payments. Call {phone} today.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 13. Big Red Estimate Callout -->
  <section class="seo-articles-section">
    <div class="container">
      <div class="big-red-callout" style="margin: 0;">
        <h3>Call For A Free Estimate on Water Heater Replacement &amp; Repiping</h3>
        <a class="big-red-phone" href={phoneHref} data-call-location="bottom_red_callout">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>{phone}</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
