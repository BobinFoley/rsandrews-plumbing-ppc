---
import SiteLayout from '../layouts/SiteLayout.astro';
import FAQ from '../components/FAQ.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { getCollection } from 'astro:content';
import { business, phone, phoneHref, reviewStats, siteUrl, stationedServiceGroups } from '../data/site';
import { getPlacementsForPage } from '../data/placements';

const homePlacements = getPlacementsForPage('/');
const homeHeroPlacement = homePlacements.find(p => p.zone === 'hero');
const homeHeroImage = homeHeroPlacement?.image || '/images/plumber-rsandrews.webp';
const homeHeroAlt = homeHeroPlacement?.imageAlt || 'RS Andrews 24/7 Emergency Plumbing Services in Metro Atlanta - Licensed Plumbers Ready to Help';

const locationCollection = await getCollection('locations');
const locationMap = new Map(locationCollection.map(item => [item.data.city?.toLowerCase(), item.id]));

const col1Cities = ['Acworth', 'Alpharetta', 'Atlanta', 'Austell', 'Brookhaven', 'Buckhead', 'Buford', 'Chamblee', 'Clarkston', 'Cumming', 'Dacula'];
const col2Cities = ['Decatur', 'Doraville', 'Druid Hills', 'Duluth', 'Dunwoody', 'East Cobb', 'Flowery Branch', 'Grayson', 'Holly Springs', 'Johns Creek'];
const col3Cities = ['Kennesaw', 'Lawrenceville', 'Lilburn', 'Mableton', 'Marietta', 'Milton', 'Norcross', 'North Decatur', 'North Druid Hills', 'Peachtree Corners', 'Powder Springs'];
const col4Cities = ['Roswell', 'Sandy Springs', 'Smyrna', 'Snellville', 'Stone Mountain', 'Sugar Hill', 'Suwanee', 'Tucker', 'Vinings', 'Woodstock'];

function getCityHref(cityName: string) {
  const slug = locationMap.get(cityName.toLowerCase());
  return slug ? `/${slug}/` : '/sitemap/';
}

const homeKeywords = "Atlanta plumber, plumber Atlanta GA, emergency plumber Atlanta, drain cleaning Atlanta GA, water heater repair Atlanta, leak detection Atlanta, 24/7 plumbing service Atlanta, RS Andrews Plumbing";
const homeGeo = {
  region: 'US-GA',
  placename: 'Atlanta, Georgia',
  position: '33.7490;-84.3880',
  icbm: '33.7490, -84.3880'
};
const homeExtraSchema = [
  {
    '@type': 'Service',
    '@id': `${siteUrl}/#service-plumbing`,
    name: '24/7 Emergency Plumbing & Drain Cleaning in Metro Atlanta',
    serviceType: 'Plumbing Repair, Drain Cleaning, Water Heater Replacement and Maintenance',
    description: 'RS Andrews provides 24/7 emergency plumbing repair, drain cleaning, water heater repair, leak detection, and whole-house repiping across Metro Atlanta. GA Master Plumber #MP210186.',
    image: `${siteUrl}/images/plumber-rsandrews.webp`,
    provider: {
      '@type': 'Plumber',
      '@id': `${siteUrl}/#business`,
      name: business.name,
      url: siteUrl,
      telephone: phone,
      image: `${siteUrl}/images/plumber-rsandrews.webp`,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3617 Clearview Parkway',
        addressLocality: 'Atlanta',
        addressRegion: 'GA',
        postalCode: '30340',
        addressCountry: 'US'
      }
    },
    areaServed: {
      '@type': 'Place',
      name: 'Metro Atlanta'
    }
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}/#faq`,
    mainEntity: [
      {
        '@type': 'Question',
        name: "Why is RS Andrews Metro Atlanta's trusted plumbing contractor?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "RS Andrews has served Metro Atlanta homeowners since 1968. Our licensed Master Plumbers (GA License #MP210186) provide upfront flat-rate pricing, 100% satisfaction guarantees, and emergency response 24 hours a day, 365 days a year. Our service trucks are stocked with commercial-grade parts to resolve most plumbing breakdowns on the spot."
        }
      },
      {
        '@type': 'Question',
        name: "What should I do immediately during a plumbing emergency in Metro Atlanta?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "First, locate and shut off your home's main water shutoff valve to prevent water damage. Turn off power to electric water heaters if they are leaking. Then call RS Andrews immediately at 404-806-9284. Our dispatchers will rush an on-call emergency plumber to your home."
        }
      },
      {
        '@type': 'Question',
        name: "Should I repair or replace my water heater?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Standard tank water heaters generally last 8 to 12 years, while tankless models last 20+ years. If your water heater is under 8 years old and experiencing a minor heating element or thermostat issue, repair is often cost-effective. If the tank is leaking from the base or showing heavy internal rust, replacement is necessary. We provide clear, written comparisons and upfront estimates."
        }
      },
      {
        '@type': 'Question',
        name: "What are the common warning signs of a hidden water leak or slab leak?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Signs include unexplained spikes in your water bill, the sound of water running when fixtures are off, warm spots on tile or hardwood floors, damp or bubbling drywall, mold odors, or low water pressure. RS Andrews uses advanced acoustic and thermal leak detection equipment to pinpoint leaks without unnecessary destruction to your walls or slab."
        }
      },
      {
        '@type': 'Question',
        name: "How does RS Andrews clear stubborn drain clogs and main sewer lines?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "We utilize heavy-duty motorized drain snakes and high-pressure hydro jetting to blast away hair, mineral scale, hardened cooking grease, and invasive tree roots. We also perform high-definition in-line sewer camera inspections so you can see inside your pipes and verify the line is completely clear."
        }
      },
      {
        '@type': 'Question',
        name: "Do you offer upfront pricing and financing for major plumbing repairs?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Yes! We operate with 100% upfront flat-rate pricing. Our technician explains the diagnostic findings and gives you exact pricing before any work starts. For larger projects like water heater replacement, sewer line repair, or whole-house repiping, we offer flexible financing with low monthly payments and competitive interest rates."
        }
      }
    ]
  }
];
---

<SiteLayout
  title="Atlanta Plumber | 24/7 Emergency Plumbing Services"
  description="RS Andrews provides 24/7 emergency plumbing, drain cleaning, water heater repair, and leak detection across Metro Atlanta. Licensed Master Plumber #MP210186. Call 404-806-9284."
  path="/"
  keywords={homeKeywords}
  geo={homeGeo}
  extraSchema={homeExtraSchema}
>
  <!-- 1. Clean Top Hero Banner (No Overlay Text) -->
  <section class="home-slider-hero" aria-label="RS Andrews Emergency Plumbing Hero">
    <img
      id="site-hero-img"
      src={homeHeroImage}
      alt={homeHeroAlt}
      width="1376"
      height="768"
      loading="eager"
    />
  </section>

  <!-- 2. Above-the-Fold Royal Blue Conversion Ribbon (Directly Under Hero Photo) -->
  <section class="blue-title-ribbon" aria-label="Primary Plumbing Call to Action">
    <div class="container hero-conversion-inner">
      <h1>Metro Atlanta Plumbing Services &amp; 24/7 Emergency Plumber</h1>
      <p class="hero-trust-strip tabular-nums">
        <span class="trust-star">★ {reviewStats.rating}</span>
        <span>{reviewStats.count} Google Reviews</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>GA Master Plumber #MP210186</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>Upfront Flat-Rate Pricing</span>
      </p>
      <div class="hero-cta-row">
        <a href={phoneHref} class="btn-phone-green hero-call-btn" data-call-location="hero_cta">
          <svg class="phone-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>Call {phone} Now</span>
        </a>
        <span class="hero-cta-note">Live Local Dispatch 24/7 · Same-Day Service Available</span>
      </div>
    </div>
  </section>

  <!-- 3. Verified Google Reviews Section -->
  <div id="reviews">
    <GoogleReviews variant="top" />
  </div>

  <!-- 4. Two-Column Intro Content & Photo -->
  <section class="section">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-copy">
          <h2>Call Now And Ask For The Plumbing Team.<br />Get The Emergency Plumber You Need Today.</h2>
          <p>
            <strong>RS Andrews Plumbing</strong> has earned Metro Atlanta's trust since 1968. If you are dealing with a burst pipe, severe drain clog, overflowing toilet, or leaking water heater, our licensed Master Plumbers (GA License #MP210186) are on call 24 hours a day, 7 days a week.
          </p>
          <p>
            Whether you need a quick faucet repair, drain hydro jetting, slab leak detection, or a brand-new high-efficiency tankless water heater, we provide straightforward flat-rate pricing, flexible financing, and a 100% satisfaction guarantee. Call RS Andrews at {phone} for rapid dispatch anywhere in Metro Atlanta.
          </p>
          <div style="margin-top: 20px;">
            <a href={phoneHref} class="btn-phone-green" data-call-location="intro_cta">
              <svg class="phone-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
              </svg>
              <span>Call {phone} Now</span>
            </a>
          </div>
        </div>
        <div class="framed-photo-box">
          <figure>
            <img
              src="/images/plumber-soldering-a-small-copper-joint.webp"
              alt="RS Andrews Master Plumber Soldering Copper Pipe Joint in Metro Atlanta"
              width="480"
              height="360"
              loading="lazy"
            />
            <figcaption>Licensed Master Plumbers Servicing Metro Atlanta 24/7</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Boxed FAQ Accordion Section -->
  <div id="faq">
    <FAQ />
  </div>

  <!-- 6. Wide Brands & Fixtures Banner -->
  <section class="truck-banner-section" aria-label="Residential Plumbing Brands, Fixtures and Appliances">
    <div class="container">
      <img
        src="/images/residential-plumbing-brands-fixtures-appliances.webp"
        alt="RS Andrews Plumbing Brands, Fixtures and Appliances Servicing Metro Atlanta 365 Days a Year"
        width="1280"
        height="714"
        loading="lazy"
      />
    </div>
  </section>

  <!-- 7. Second Two-Column Content & Photo -->
  <section class="section" style="padding: 20px 0 40px;">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-copy">
          <h2>Stocked Service Trucks Ready To Solve Your Plumbing Issue On The First Visit</h2>
          <p>
            Allow RS Andrews to be your trusted partner for keeping your home's water supply and drainage systems running cleanly and smoothly. We are a locally operated plumbing company proud to hold Georgia Master Plumber License #MP210186.
          </p>
          <p>
            Our plumbers arrive in fully equipped service vans stocked with commercial-grade fixtures, motorized augers, acoustic leak detection tools, and replacement parts to complete most repairs on the spot. From kitchen and bathroom fixtures to emergency sewer line repairs, every job is backed by our 100% satisfaction guarantee. Call {phone} today.
          </p>
        </div>
        <div class="framed-photo-box">
          <figure>
            <img
              src="/images/tankless-water-heater5fg.webp"
              alt="RS Andrews High-Efficiency Tankless Water Heater Installation & Repair Metro Atlanta"
              width="480"
              height="480"
              loading="lazy"
            />
            <figcaption>Metro Atlanta Tankless Water Heater Installation &amp; Repair</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Second Google Reviews Section -->
  <GoogleReviews variant="bottom" />

  <!-- 9. Stationed Techs 24/7 Clickable Plumbing Services Grid -->
  <section class="stationed-techs-section">
    <div class="container">
      <h2>Call R.S. Andrews Day or Night. Weekends Too. We've Got Plumbers Stationed Throughout Metro Atlanta 24/7 for Fast Local Service.</h2>

      <div class="stationed-cards-grid">
        {stationedServiceGroups.map(group => (
          <div class="stationed-card">
            <ul>
              {group.map(service => (
                <li><a href={service.href}>{service.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. Deep Blue Metro Atlanta Service Area Box -->
  <section class="blue-service-box-section">
    <div class="container">
      <div class="blue-service-box">
        <h2>RS Andrews Plumbing, Drain Cleaning, and Water Heater Service Area</h2>

        <div class="blue-service-cities-grid">
          <div class="city-col">
            {col1Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col2Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col3Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
          <div class="city-col">
            {col4Cities.map(city => (
              <a href={getCityHref(city)}>{city}</a>
            ))}
          </div>
        </div>

        <div class="blue-service-bottom-bar">
          Plumbing Repair, Drain Cleaning, Water Heater Replacement, and Sewer Line Solutions. Call {phone} for Same-Day Dispatch &amp; Financing Options.
        </div>
      </div>
    </div>
  </section>

  <!-- 11. Brands Serviced & Financing Section -->
  <section class="brands-financing-section">
    <div class="container">
      <div class="section-heading" style="text-align: center; margin-bottom: 30px;">
        <h2 style="font-size: clamp(1.35rem, 2.5vw, 1.85rem); color: #123954; font-weight: 800;">
          Plumbing &amp; Water Heater Brands Serviced: Bradford White, Rheem, A.O. Smith, Rinnai, Navien, Kohler, Moen, Delta, American Standard, and More.
        </h2>
      </div>

      <div class="brands-grid-layout">
        <div class="brands-media-box">
          <figure>
            <img
              src="/images/2558-rheem-water-heater-installation.webp"
              alt="RS Andrews Professional Rheem Water Heater Installation & Replacement Metro Atlanta"
              width="720"
              height="1280"
              loading="lazy"
              style="max-height: 520px; object-fit: cover;"
            />
            <figcaption>Professional Rheem Water Heater Installation &amp; Service</figcaption>
          </figure>
        </div>

        <div class="brands-copy-box">
          <h3>Water Heater Installation, Replacement and Financing for Metro Atlanta</h3>
          <p>
            If your water heater is leaking, struggling to supply hot water, or making rumbling sediment noises, call the licensed Master Plumbers at <strong>R.S. Andrews Plumbing</strong> for an honest diagnosis and free second opinion.
          </p>
          <p>
            If replacement is your best option, <strong>R.S. Andrews</strong> delivers competitive, upfront estimates on high-efficiency tankless and conventional tank water heaters with professional installation and manufacturer warranties. Call {phone} now.
          </p>

          <h4>Call For Special Seasonal Pricing on Tankless Water Heaters</h4>
          <p>
            Upgrade to endless hot water on demand with an energy-efficient <a href="/tankless-water-heaters/">tankless water heater</a>. Enjoy lower utility bills, a compact wall-mounted footprint, and up to double the lifespan of traditional tank heaters.
          </p>

          <h4>Flexible Financing Available At Competitive Rates</h4>
          <p>
            Unexpected plumbing emergencies shouldn't disrupt your family's budget. We offer <a href="/plumbing-financing/">flexible financing programs</a> with low monthly payment plans for water heater replacements, sewer line repairs, and whole-house repiping.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. Plumbing Content Highlights -->
  <section class="seo-articles-section">
    <div class="container">
      <div class="seo-article-block">
        <h3>Water Quality &amp; Whole-Home Filtration in Metro Atlanta</h3>
        <p>
          Clean, healthy water is essential for your family. North Georgia municipal water systems often carry chlorine, sediment, and minerals that cause scale buildup inside pipes, water heaters, and fixtures. RS Andrews installs <a href="/water-filtration-softeners/">whole-home water filtration systems and water softeners</a> that protect your appliances and deliver crisp, great-tasting water from every faucet.
        </p>
      </div>

      <div class="seo-article-block">
        <h3>Sewer Line Repair, Hydro Jetting &amp; Camera Inspections</h3>
        <p>
          Slow drains and recurring sewage backups are frequently caused by tree root intrusion, cracked underground clay or cast-iron pipes, or heavy grease buildup in the main sewer line. Our Atlanta plumbing team uses high-definition fiber-optic sewer cameras to pinpoint the exact location and depth of <a href="/sewer-line-repair/">sewer line blockages</a>.
        </p>
        <p>
          With high-pressure <a href="/drain-cleaning/">hydro jetting</a> and modern trenchless pipe repair methods, we restore full sewer line flow quickly while protecting your lawn, driveway, and landscaping.
        </p>
      </div>

      <div class="seo-article-block">
        <h3>Preventative Plumbing Safety Inspections</h3>
        <p>
          High municipal water pressure in Metro Atlanta can quietly exceed 80 PSI, stressing copper and PEX fittings, water heater tanks, and washing machine supply hoses until they suddenly burst.
        </p>
        <p>
          Schedule an annual <a href="/preventative-maintenance/">plumbing safety inspection</a> with RS Andrews. We test your incoming water pressure, inspect shutoff valves, check for hidden slab leaks, and flush sediment from your water heater to prevent unexpected flooding.
        </p>
      </div>

      <!-- 13. Big Red Estimate Callout -->
      <div class="big-red-callout">
        <h3>Call For A Free Estimate on Water Heater Replacement &amp; Repiping</h3>
        <a class="big-red-phone" href={phoneHref} data-call-location="bottom_red_callout">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
          <span>{phone}</span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
